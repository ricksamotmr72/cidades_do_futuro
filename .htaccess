# Configuração para hospedagens Apache (cPanel, HostGator, Locaweb, Hostinger...).
# Em outros servidores este arquivo é simplesmente ignorado.

DirectoryIndex index.html
Options -Indexes

# Tipos corretos (módulos JS e vídeos)
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType video/mp4 .mp4 .m4v
    AddType video/webm .webm
    AddCharset utf-8 .html .css .js
</IfModule>

# Compressão de texto
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

# Cache no navegador: vídeos e imagens mudam pouco; HTML sempre revalida
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# Não publica arquivos de desenvolvimento
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(scripts|legado|assets/videos/originais)(/|$)
    RedirectMatch 404 /(README\.md|\.gitignore)$
</IfModule>
